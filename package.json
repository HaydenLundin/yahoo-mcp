{
  "name": "yahoo-mcp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Remote MCP server exposing a Yahoo Mail account to AI clients with Gmail-connector-parity permissions.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc -p tsconfig.json",
    "e2e": "node scripts/e2e-oauth.mjs",
    "db:migrate:local": "wrangler d1 migrations apply yahoo_mcp --local",
    "db:migrate:remote": "wrangler d1 migrations apply yahoo_mcp --remote",
    "audit:tail": "wrangler d1 execute yahoo_mcp --remote --command \"SELECT ts, client_name, tool, uids, outcome FROM audit_log ORDER BY ts DESC LIMIT 50\"",
    "spike:dev": "wrangler dev -c spike/wrangler.jsonc",
    "spike:remote": "wrangler dev -c spike/wrangler.jsonc --remote"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^0.10.3",
    "@hono/mcp": "^0.3.2",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "hono": "^4.13.7",
    "imapflow": "^2.0.0",
    "jose": "^6.2.12",
    "zod": "^4.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260908.1",
    "@types/node": "^26.5.0",
    "typescript": "^7.0.2",
    "wrangler": "^4.130.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  }
}
