{
  "name": "yahoo-mcp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Remote MCP server exposing a Yahoo Mail account to AI clients with Gmail-connector-parity permissions.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc -p tsconfig.json",
    "e2e": "node scripts/e2e-oauth.mjs",
    "db:migrate:local": "wrangler d1 migrations apply yahoo_mcp --local",
    "db:migrate:remote": "wrangler d1 migrations apply yahoo_mcp --remote",
    "audit:tail": "wrangler d1 execute yahoo_mcp --remote --command \"SELECT ts, client_name, tool, uids, outcome, detail FROM audit_log ORDER BY ts DESC LIMIT 50\"",
    "spike:dev": "wrangler dev -c spike/wrangler.jsonc",
    "spike:remote": "wrangler dev -c spike/wrangler.jsonc --remote",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^0.10.4",
    "@hono/mcp": "^0.3.2",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "hono": "^4.13.13",
    "iconv-lite": "^0.7.3",
    "imapflow": "^2.4.0",
    "jose": "^6.2.12",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261011.1",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "wrangler": "^4.149.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  }
}
